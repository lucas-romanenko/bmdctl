$ bmdctl hosts alias BC 1.2 - TESTTt bc
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  alias       bc

$ bmdctl hosts alias bc BC
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  alias       bc → BC

$ bmdctl hosts alias bc bt
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  alias       BC → bt

$ bmdctl hosts alias bt --rm
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  alias       bt → <dim>none</>

$ bmdctl hosts alias BC 1.2 - TESTTt --rm
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  alias       <dim>none</>                                               <dim>already</>

$ bmdctl hosts alias BC 1.2 - TESTTt bc
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  alias       bc

$ bmdctl hosts alias studio cut
! <red>error</>  "cut" is a command, so it can't be an alias
[exit 1]

$ bmdctl 
<dim>bmdctl VERSION</>

  bc  <b>BC 1.2 - TESTTt</>  192.0.2.10  <dim>ATEM</>  1080p50          ● 0s<dim> · idle #s</>
      <b>studio</>           192.0.2.11  <dim>ATEM</>  1080p50          ● 0s<dim> · idle #s</>

  <dim>bmdctl help</>

$ bmdctl bc program cam1
<b>BC 1.2 - TESTTt</>  <dim>PGM CAM2 · PVW CAM1</>
  program     CAM2 → <red>CAM1</>                                           <dim># ms</>

$ bmdctl STUDIO preview cam1
<b>studio</>  <dim>PGM CAM2 · PVW CAM1</>
  preview     <green>CAM1</>                                               <dim>already</>

$ bmdctl progam 2
! <red>error</>  no command or host named "progam"
!        <dim>hosts: bc · studio · stage · bmdctl --help lists the commands</>
[exit 1]

$ bmdctl st cut
! <red>error</>  "st" could be "studio" or "stage": give more of the name
!        <dim>bmdctl hosts lists them</>
[exit 1]

$ bmdctl bc progam 2
! <red>error</>  unknown command "progam"
!        <dim>bmdctl --help lists them</>
[exit 1]

$ bmdctl use bc
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  default     bc

$ bmdctl use bc
<b>BC 1.2 - TESTTt</>  <dim>192.0.2.10</>
  default     bc                                                 <dim>already</>

$ bmdctl use stage
