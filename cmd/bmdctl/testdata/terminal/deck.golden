$ bmdctl connect 192.0.2.20
<b>Deck 1</>  <dim>stopped · clip 1 · 1080p25 · connected # ms</>
  <b>saved as "Deck 1", now the default</>

$ bmdctl --host deck 1 status
<b>Deck 1</>  <dim>HyperDeck Studio HD Mini · 1080p25 · session 0s, idle #s, pinned</>

  transport   stopped · loop off · single clip off
  timecode    00:00:00:00
  clip        <dim>1</>  Intro Loop animation.mp4  <dim>00:01:03:17</>
  timeline    3 clips
  slot 1      SD1 · mounted · 2h00m left                        <dim>● active</>
  slot 2      SD2 · mounted · 1h00m left
  remote      on

$ bmdctl --host deck 1 clips
<b>Deck 1</>  <dim>stopped · clip 1 · timeline · 3 clips</>

  <dim>1</>  Intro Loop animation.mp4  <dim>00:01:03:17</>                     ● stopped
  <dim>2</>  Interview.mov             <dim>00:00:30:00</>
  <dim>3</>  Outro.mov                 <dim>00:00:10:00</>

$ bmdctl --host deck 1 play --speed 50
<b>Deck 1</>  <dim>stopped · clip 1</>
  play        stopped → play 50%                                    <dim># ms</>

$ bmdctl --host deck 1 loop on
<b>Deck 1</>  <dim>play · clip 1</>
  loop        off → on                                              <dim># ms</>
!   <dim>hyperdeck loop is unverified on hardware</>

$ bmdctl --host deck 1 next
<b>Deck 1</>  <dim>play · clip 1</>
  next        Intro Loop animation.mp4 → Interview.mov              <dim># ms</>
!   <dim>hyperdeck next is unverified on hardware</>

$ bmdctl --host deck 1 stop
<b>Deck 1</>  <dim>play · clip 2</>
  stop        play 50% → stopped                                    <dim># ms</>

$ bmdctl --host deck 1 stop
<b>Deck 1</>  <dim>stopped · clip 2</>
  stop        stopped                                            <dim>already</>

$ bmdctl --host deck 1 goto outro
<b>Deck 1</>  <dim>stopped · clip 2</>
  goto        Interview.mov → Outro.mov                             <dim># ms</>

$ bmdctl --host deck 1 record Take 2
<b>Deck 1</>  <dim>stopped · clip 3</>
  record      stopped → <red>record</>                                      <dim># ms</>
!   <dim>hyperdeck record is unverified on hardware</>

$ bmdctl --host deck 1 stop
<b>Deck 1</>  <dim>record · clip 3</>
  stop        record → stopped                                      <dim># ms</>

$ bmdctl --host deck 1 loop off
!   <dim>hyperdeck loop is unverified on hardware</>
! <red>error</>  the deck is stopped: loop changes a playback under way
!        <dim>bmdctl play --loop starts one looping</>
[exit 1]

$ bmdctl --host deck 1 program 2
! <red>error</>  Deck 1 (192.0.2.20) is a HyperDeck
!        <dim>bmdctl hyperdeck --help</>
[exit 1]

$ bmdctl --host deck 1 clips --disk
<b>Deck 1</>  <dim>stopped · clip 3 · slot 1's disk · 4 clips</>

  <dim>1</>  Intro Loop animation.mp4  <dim>H.264 1080p25</>              <dim>00:01:03:17</>
  <dim>2</>  Interview.mov             <dim>QuickTimeProResHQ 1080p25</>  <dim>00:00:30:00</>
  <dim>3</>  Outro.mov                 <dim>QuickTimeProResHQ 1080p25</>  <dim>00:00:10:00</>
  <dim>4</>  Take 2.mov                <dim>QuickTimeProResHQ 1080p25</>  <dim>00:00:02:00</>

$ bmdctl --host deck 1 timeline add Outro.mov --before 1
<b>Deck 1</>  <dim>stopped · clip 3</>
  timeline add  4 clips → 5 clips                                   <dim># ms</>

$ bmdctl --host deck 1 timeline remove intro
<b>Deck 1</>  <dim>stopped · clip 3</>
  timeline remove  5 clips → 4 clips                                <dim># ms</>

$ bmdctl --host deck 1 timeline clear
<b>Deck 1</>  <dim>stopped · clip 3</>
  Deck 1's timeline loses its 4 clips; the files stay on the disk
  clear it? [y/N] y
  timeline clear  4 clips → empty                                   <dim># ms</>

$ bmdctl --host deck 1 disconnect
<b>Deck 1</>  disconnected

